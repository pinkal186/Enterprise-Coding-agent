{
  "name": "engineering-agent",
  "version": "0.1.0",
  "description": "Minimal provider-agnostic coding agent — Iteration 1 MVP",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "start": "tsx src/cli/main.ts",
