  "assumptions": [],
  "invariants": [
    {
      "id": "INVARIANT-7e79919c",
      "text": "All file operations (read, search, edit, write) and command execution paths must strictly validate that targets reside within the configured workspace directory. Paths outside the workspace must be rejected.",
      "source": "Engineering Agent — System Design Document §11",
      "recorded_at": "2026-09-05T13:14:55.443Z"
    },
    {
      "id": "INVARIANT-cd74c5ed",
      "text": "The agent must never declare a coding task successful solely because the LLM produced a confident text response. Completion requires explicit verification (e.g., running tests/builds) or clear reporting of unverified status.",
      "source": "Engineering Agent — System Design Document §9",
      "recorded_at": "2026-09-05T13:14:55.610Z"
    },
    {
      "id": "INVARIANT-72ddae88",
      "text": "The agent loop must enforce a hard iteration cap (default 20) and detect repeated identical failing actions to prevent runaway execution or infinite thrashing loops.",
      "source": "Engineering Agent — Iteration 1 Technical Implementation Plan §16, §17",
      "recorded_at": "2026-09-05T13:14:55.784Z"
    }
  ],
  "decisions": [
    {
      "id": "DECISION-6bafb546",
      "title": "Provider-Agnostic LLM Abstraction",
      "text": "The Agent Loop must communicate with LLMs strictly through an internal provider-independent LLM interface. Direct SDK imports (e.g., Gemini) are confined entirely to their respective adapter modules.",
      "status": "accepted",
      "source": "Engineering Agent — Iteration 1 Technical Implementation Plan §4",
      "recorded_at": "2026-09-05T13:14:55.025Z"
    },
    {
      "id": "DECISION-7a8c0b9f",
      "title": "Zero External Agent Frameworks",
      "text": "Do not introduce LangChain, LlamaIndex, AutoGen, CrewAI, or other agent frameworks. The agent runtime, loop, state, tools, context, and provider adapters must be built directly using TypeScript/Node.js to ensure deep mechanical understanding.",
      "status": "accepted",
      "source": "Engineering Agent — Iteration 1 Technical Implementation Plan §3",
      "recorded_at": "2026-09-05T13:14:55.262Z"
    },
    {
      "id": "DECISION-0afb640c",
      "title": "Default Gemini Model: gemini-2.5-flash",
      "text": "The default Gemini model for Iteration 1 is gemini-2.5-flash via the @google/genai SDK. Configured via GEMINI_MODEL environment variable.",
      "status": "accepted",
      "source": "Human answer: Pinkal, 2026-09-05",
      "recorded_at": "2026-09-05T13:52:33.202Z"
    },
    {
      "id": "DECISION-f4dc31e7",
      "title": "Edit Tool: Both replace and write operations",
      "text": "The file editing tool (src/tools/edit-file.ts) supports two operations in a single tool: (a) replace — exact deterministic substring replacement with single-match validation, and (b) write — create or overwrite entire file content.",
      "status": "accepted",
      "source": "Human answer: Pinkal, 2026-09-05",
      "recorded_at": "2026-09-05T13:52:49.401Z"
    },
    {
      "id": "DECISION-5938fbd0",
      "title": "Search Tool: Pure Node.js recursive directory walker",
      "text": "The search tool (src/tools/search.ts) implements a pure TypeScript/Node.js recursive directory traversal with regex/substring matching. No external binaries (ripgrep, grep, findstr) are required. This ensures 100% cross-platform compatibility on Windows, Linux, and macOS.",
      "status": "accepted",
      "source": "Human answer: Pinkal, 2026-09-05",
      "recorded_at": "2026-09-05T13:53:04.274Z"
    },
    {
      "id": "DECISION-ed75c99a",
      "title": "Command Safety: Deny-by-default for non-allowlisted commands",
      "text": "In non-interactive runs, any command not in the explicit allowlist (npm test, npm run test, npm run build, npm run lint, node ...) is immediately denied with a structured error message returned to the agent loop. No interactive confirmation prompts.",
      "status": "accepted",
      "source": "Human answer: Pinkal, 2026-09-05",
      "recorded_at": "2026-09-05T13:53:14.766Z"
    },
    {
      "id": "DECISION-f111a490",
      "title": "Project files at repo root, not subdirectory",
      "text": "All TypeScript project files (package.json, tsconfig.json, src/, tests/, eval/) live at the Genesis repo root. This is required because genesis gate runs commands from the repo root directory. A separate engineering-agent/ subdirectory would cause all gate commands to fail.",
      "status": "accepted",
      "source": "Discovered during TASK-01 gate execution, 2026-09-05",
      "recorded_at": "2026-09-05T14:30:33.861Z"
    }
  ],
  "knowledge": [
    {
      "id": "KNOWLEDGE-ec240f64",
      "title": "Iteration 1 Boundary & Non-Goals",
      "text": "Iteration 1 MVP is strictly limited to CLI, Agent Runtime, Agent Loop, Gemini Adapter, 4 Core Tools (Read, Search, Edit/Write, Run Command), basic context with limits, structured event logging, unit tests, integration test fixture, and 5 evaluation tasks. Excludes RAG, vector DBs, sub-agents, memory, git automation, and web UI.",
      "source": "Engineering Agent — Iteration 1 Technical Implementation Plan §31",
      "tags": [],
      "recorded_at": "2026-09-05T13:14:55.957Z"
    }
  ],
