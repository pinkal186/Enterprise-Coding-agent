# Engineering Agent — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.

# Required: Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Model selection (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Agent execution limits
MAX_AGENT_ITERATIONS=20
MAX_REPEATED_FAILURES=3

# Optional: Tool output limits (characters)
MAX_FILE_READ_CHARS=50000
MAX_SEARCH_OUTPUT_CHARS=20000
MAX_COMMAND_OUTPUT_CHARS=20000

# Optional: Command timeout (milliseconds)
COMMAND_TIMEOUT_MS=30000

# Optional: Log file path (defaults to stderr only)
# LOG_FILE=./agent-run.jsonl
